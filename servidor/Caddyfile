# HTTPS automatico (Let's Encrypt) con un dominio gratuito de sslip.io, que
# resuelve a la IP de la VM sin registrar nada. Necesita los puertos 80 y 443
# abiertos en el grupo de seguridad de Azure.
__DOMINIO__ {
	encode gzip
	reverse_proxy 127.0.0.1:8050
}

# Dashboards de OTRAS personas (servidor/nueva_instancia.sh): un archivo por
# persona. Sin archivos, Caddy solo avisa y sigue.
import /etc/caddy/instancias/*.caddy
